# SSH — managed from ~/.dotfiles
# Keep OrbStack's dynamically generated host entries available.
Include ~/.orbstack/ssh/config

# Named SSH hosts work both with `ssh nas` and with the shell shortcuts.
Host nas
  HostName 192.168.2.237
  User sascha

# Isolated Codex development container on the NAS (LAN only; no router rule).
Host nas-codex
  HostName 192.168.2.237
  Port 2223
  User dev
  # Public key selects the private key held by Bitwarden's SSH agent.
  IdentityFile ~/.ssh/id_ed25519_nas_codex_devbox.pub
  IdentitiesOnly yes
  ForwardAgent yes
  SetEnv TERM=xterm-256color
  StrictHostKeyChecking yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

# Same Devbox when away from home.  Traffic uses the existing SSH endpoint on
# the VPS, then a command-only hop to the NAS; no extra public port is opened.
Host nas-codex-remote
  HostName nas-codex-via-vps
  User dev
  IdentityFile ~/.ssh/id_ed25519_nas_codex_devbox.pub
  IdentitiesOnly yes
  ForwardAgent yes
  SetEnv TERM=xterm-256color
  ProxyCommand ssh -o BatchMode=yes nas-remote nc 127.0.0.1 2223
  HostKeyAlias [192.168.2.237]:2223
  StrictHostKeyChecking yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host nas-remote
  HostName hundert.cc
  User sascha
  Port 2222

# Always ask Bitwarden's SSH agent for identities, regardless of which agent
# socket was inherited by the terminal or a long-running terminal multiplexer.
Host *
  IdentityAgent ~/.bitwarden-ssh-agent.sock
